# Copy this file to ".env" and fill in your values. Never upload ".env" to GitHub.

# Database (free MongoDB Atlas): mongodb+srv://user:password@cluster.mongodb.net
MONGO_URL=
DB_NAME=noonelistening

# Echo's brain. Use at least ONE of these two.
# Claude (best for real users, paid, tiny cost per chat):
ANTHROPIC_API_KEY=
# Gemini (free for testing only, see README):
GEMINI_API_KEY=

# The human voice always uses Gemini, so GEMINI_API_KEY is needed for voice.
# Optional: change models without touching code
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Your website address, once deployed (use * only while testing)
CORS_ORIGINS=*
